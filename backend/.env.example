NODE_ENV=development
PORT=3001
API_PREFIX=api/v1

# Use a local PostgreSQL database for development and tests.
DATABASE_URL=postgresql://ksa:change-me@localhost:5432/ksa_attendance
DATABASE_POOL_MAX=10
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Same-origin development frontend/API origins. Separate values with commas.
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001
PUBLIC_APP_URL=http://localhost:3000
API_DOCS_ENABLED=true

# Cookies are host-only: do not add a Domain attribute.
SESSION_COOKIE_NAME=ksa_session
ATTENDANCE_DEVICE_COOKIE_NAME=ksa_attendance_device
COOKIE_SECURE=false
SESSION_IDLE_DAYS=30
SESSION_ABSOLUTE_DAYS=90
AUTH_TOKEN_ENCRYPTION_KEY=

# PostgreSQL-backed jobs are the MVP default. No Redis is used. The worker can
# run as a separate process, or the zero-cost profile can use the protected
# one-shot endpoint called by a free scheduler.
JOB_QUEUE_DRIVER=postgres
DEPLOYMENT_PROFILE=standard
JOB_RUNNER_MODE=worker
JOB_RUNNER_SECRET=

# Use memory only for local foundation tests. The zero-cost deployment uses a
# private Supabase Storage bucket. The legacy paid profile can use r2.
STORAGE_DRIVER=memory
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_PRESIGNED_URL_TTL_SECONDS=300
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=

# Transactional email. Use memory locally; production requires Resend.
EMAIL_DRIVER=memory
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Google Sheets projection. Keep memory for local development; production uses
# a least-privilege service account shared only to the target workbook.
GOOGLE_SHEETS_DRIVER=memory
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Optional; Sentry must be configured with replay disabled and sensitive-field filtering.
SENTRY_DSN=
